<div class="container mx-auto px-4 py-8 max-w-4xl" data-escape-to-kanban-url="<%= kanban_path %>"
     data-controller="translate"
     data-translate-url-value="<%= translate_task_path(@task) %>"
     data-translate-update-url-value="<%= task_path(@task) %>"
     data-translate-ollama-health-url-value="<%= task_insights_ollama_health_path %>">
  <div class="mb-8">
    <div class="flex justify-between items-start">
      <div>
        <div class="flex items-center space-x-4">
          <%= button_to toggle_task_path(@task), method: :patch, class: "flex-shrink-0", form: { data: { turbo: false, task_completed: @task.completed.to_s, task_title: @task.title, project_name: @task.project&.title } } do %>
            <div class="w-8 h-8 border-2 rounded <%= @task.completed ? 'bg-green-500 border-green-500' : 'border-gray-400' %>">
              <% if @task.completed %>
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              <% end %>
            </div>
          <% end %>
          <h1 class="text-3xl font-bold text-gray-900 <%= @task.completed ? 'line-through' : '' %>">
            <%= @task.title %>
          </h1>
        </div>
        <% if @task.project %>
          <p class="mt-2 text-gray-600">
            <%= t('views.tasks.show.project') %>: <%= link_to @task.project.title, project_path(@task.project), class: "text-blue-600 hover:text-blue-800", data: { turbo: false } %>
          </p>
        <% end %>
      </div>
      <div class="flex space-x-3">
        <%= button_to refresh_task_path(@task), method: :patch, 
            class: 'bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded',
            form: { data: { turbo: false } } do %>
          <%= t('views.tasks.show.refresh') %>
        <% end %>
        <%= link_to t('views.tasks.show.edit_task'), edit_task_path(@task),
            class: 'bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded',
            data: { turbo: false } %>
        <%= link_to t('views.tasks.show.duplicate_task'), new_project_task_path(@task.project, source_task_id: @task.id),
            class: 'bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded',
            data: { turbo: false } %>
        <button type="button" data-translate-target="button" data-action="translate#openModal"
                title="<%= t('views.tasks.show.translate.tooltip') %>"
                class="bg-indigo-500 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded">
          <%= t('views.tasks.show.translate.button') %>
        </button>
      </div>
    </div>

    <p data-translate-target="error" data-generic-error="<%= t('views.tasks.show.translate.generic_error') %>"
       class="mt-4 hidden text-sm text-red-700 bg-red-50 border-l-4 border-red-400 p-3 rounded-md"></p>

    <div data-translate-target="modal" class="hidden fixed inset-0 bg-gray-600/50 overflow-y-auto h-full w-full z-50">
      <div class="relative top-20 mx-auto p-5 border w-full max-w-md shadow-lg rounded-md surface">
        <h3 class="text-lg font-medium text-gray-900 mb-2"><%= t('views.tasks.show.translate.confirm_title') %></h3>
        <p class="text-sm text-gray-600 mb-4">
          <%= t('views.tasks.show.translate.confirm_body', language: @translate_target_language_preview) %>
        </p>
        <div class="mb-4">
          <label for="translate-model" class="block text-sm font-medium text-gray-700 mb-1">
            <%= t('views.tasks.show.translate.model_label') %>
          </label>
          <%= render 'shared/llm_model_field', id: 'translate-model', name: 'model',
              value: @translate_default_model_preview, data: { translate_target: "modelInput" } %>
        </div>
        <div class="flex justify-end space-x-3">
          <button type="button" data-action="translate#cancelModal"
                  class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 border border-gray-300 rounded-md hover:bg-gray-200">
            <%= t('views.tasks.show.translate.dismiss') %>
          </button>
          <button type="button" data-translate-target="confirmButton" data-action="translate#confirm"
                  class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 border border-transparent rounded-md hover:bg-indigo-700">
            <%= t('views.tasks.show.translate.button') %>
          </button>
        </div>
      </div>
    </div>

    <div data-translate-target="panel" class="mt-4 hidden surface rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-3"><%= t('views.tasks.show.translate.panel_title') %></h2>
      <div class="space-y-3">
        <div>
          <h3 class="text-sm font-medium text-gray-500"><%= t('views.tasks.show.translate.translated_title') %></h3>
          <p data-translate-target="title" class="mt-1 text-gray-900 font-medium"></p>
        </div>
        <div>
          <h3 class="text-sm font-medium text-gray-500"><%= t('views.tasks.show.translate.translated_description') %></h3>
          <p data-translate-target="description" class="mt-1 text-gray-900 whitespace-pre-line"></p>
        </div>
      </div>
      <div class="mt-4 flex space-x-3">
        <button type="button" data-action="translate#apply"
                class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700">
          <%= t('views.tasks.show.translate.apply') %>
        </button>
        <button type="button" data-action="translate#dismiss"
                class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
          <%= t('views.tasks.show.translate.dismiss') %>
        </button>
      </div>
    </div>

    <div class="mt-6 space-y-4">
      <div class="surface rounded-lg shadow p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4"><%= t('views.tasks.show.details') %></h2>
        <div class="space-y-4">
          <div class="flex space-x-6">
            <div>
              <h3 class="text-sm font-medium text-gray-500"><%= t('views.tasks.show.priority') %></h3>
              <%= render 'shared/priority_badge', 
                  priority: @task.priority, 
                  size: 'text-sm',
                  additional_classes: 'mt-1 inline-block px-2 py-1' %>
            </div>

            <div>
              <h3 class="text-sm font-medium text-gray-500"><%= t('views.tasks.show.status') %></h3>
              <%= render 'shared/status_badge',
                  status: @task.status,
                  size: 'text-sm',
                  additional_classes: 'mt-1 inline-block' %>
            </div>

            <% if @task.task_category %>
              <div>
                <h3 class="text-sm font-medium text-gray-500"><%= t('views.tasks.show.category') %></h3>
                <%= render 'shared/category_badge',
                    task_category: @task.task_category,
                    size: 'text-sm',
                    additional_classes: 'mt-1 inline-block px-2 py-1' %>
              </div>
            <% end %>

            <% if @task.task_result %>
              <div>
                <h3 class="text-sm font-medium text-gray-500"><%= t('views.tasks.result_modal.result_label') %></h3>
                <span class="mt-1 inline-block px-2 py-1 text-sm rounded-full <%= @task.task_result.result_incomplete? ? 'bg-amber-100 text-amber-800' : 'bg-green-100 text-green-800' %>">
                  <%= t("task_results.values.#{@task.task_result.result}") %>
                </span>
                <% if @task.task_result.result_incomplete? %>
                  <p class="mt-1 text-xs text-gray-600"><%= @task.task_result.result_reason %></p>
                <% end %>
              </div>
            <% end %>

            <% if @task.due_date %>
              <div>
                <h3 class="text-sm font-medium text-gray-500"><%= t('views.tasks.show.due_date') %></h3>
                <p class="mt-1 text-gray-900">
                  <%= @task.due_date.strftime("%B %d, %Y") %>
                </p>
              </div>
            <% end %>

            <% if @task.estimated_minutes %>
              <div>
                <h3 class="text-sm font-medium text-gray-500"><%= t('views.tasks.show.estimated_minutes') %></h3>
                <p class="mt-1 text-gray-900">
                  <%= t('views.tasks.show.estimated_minutes_value', count: @task.estimated_minutes) %>
                </p>
              </div>
            <% end %>
          </div>

          <div>
            <h3 class="text-sm font-medium text-gray-500"><%= t('views.tasks.show.description') %></h3>
            <div class="mt-1 text-gray-900 prose prose-sm max-w-none"><%= markdown_robust(@task.description) %></div>
          </div>

          <div class="flex flex-wrap gap-2">
            <% @task.tags.each do |tag| %>
              <span class="px-2 py-1 text-sm rounded-full bg-gray-100 text-gray-800">
                <%= tag.name %>
              </span>
            <% end %>
          </div>
        </div>
      </div>

      <div class="surface rounded-lg shadow p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4"><%= t('views.tasks.show.comments') %></h2>
        
        <%= form_with(model: [@task, @comment], class: "mb-6", data: { turbo: false }) do |f| %>
          <div>
            <%= f.text_area :content, 
                rows: 3, 
                placeholder: t('views.tasks.show.add_comment_placeholder'),
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
          </div>

          <div class="mt-3 flex justify-end">
            <%= f.submit t('views.tasks.show.post_comment'), 
                class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          </div>
        <% end %>

        <div class="space-y-4">
          <% @comments.each do |comment| %>
            <div class="flex space-x-3 p-4 surface rounded-lg" style="background-color: var(--color-surface-elevated);">
              <div class="flex-1">
                <div class="flex items-center justify-between">
                  <h3 class="text-sm font-medium text-gray-900">
                    <%= comment.user.name %>
                  </h3>
                  <p class="text-sm text-gray-500">
                    <%= time_ago_in_words(comment.created_at) %> ago
                  </p>
                </div>
                <div class="mt-2 text-sm text-gray-700 prose prose-sm max-w-none">
                  <%= markdown_robust(comment.content) %>
                </div>
              </div>
              
              <%= button_to comment_path(comment), 
                  method: :delete,
                  class: "text-gray-400 hover:text-red-500",
                  form: { data: { turbo: false } },
                  data: { confirm: t('views.tasks.show.delete_confirm') } do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="surface rounded-lg shadow p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4"><%= t('views.attachments.section_title') %></h2>

        <%= form_with(url: task_attachments_path(@task), method: :post, class: "mb-6", multipart: true, data: { turbo: false }) do %>
          <div class="flex items-center gap-3">
            <%= file_field_tag "attachment[file]",
                class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
            <%= submit_tag t('views.attachments.upload'),
                class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 whitespace-nowrap" %>
          </div>
        <% end %>

        <% if @attachments.any? %>
          <div class="space-y-3">
            <% @attachments.each do |attachment| %>
              <%= render "attachments/attachment", attachment: attachment %>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-500"><%= t('views.attachments.none_yet') %></p>
        <% end %>
      </div>

      <%= render "status_history" %>
    </div>
  </div>
</div>

 