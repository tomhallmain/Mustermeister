<div class="container mx-auto px-4 py-8 max-w-2xl">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900"><%= t('views.projects.merge.title', source_title: @project.title) %></h1>
  </div>

  <% if @target.nil? %>
    <div class="surface shadow-lg rounded-lg p-6">
      <% if @mergeable_projects.empty? %>
        <p class="text-gray-600"><%= t('views.projects.merge.no_other_projects') %></p>
      <% else %>
        <%= form_with url: merge_project_path(@project), method: :get, class: "space-y-4" do |f| %>
          <div>
            <%= f.label :target_id, t('views.projects.merge.target_label'), class: "block text-sm font-medium text-gray-700" %>
            <%= f.select :target_id,
                  options_from_collection_for_select(@mergeable_projects, :id, :title),
                  { include_blank: t('views.projects.merge.select_target') },
                  { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" } %>
          </div>
          <%= f.submit t('views.projects.merge.continue'), class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700" %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded-md mb-6">
      <p class="text-sm text-yellow-800">
        <%= t('views.projects.merge.warning', source_title: @project.title, target_title: @target.title) %>
      </p>
    </div>

    <%= form_with url: merge_execute_project_path(@project), method: :post, class: "space-y-6" do |f| %>
      <%= hidden_field_tag 'merge[target_id]', @target.id %>

      <% MergeProjectsService::MERGEABLE_FIELDS.each do |field| %>
        <fieldset class="surface rounded-lg shadow p-4">
          <legend class="font-semibold text-gray-900 px-1"><%= t("views.projects.merge.fields.#{field}") %></legend>
          <div class="mt-2 space-y-2">
            <label class="flex items-center space-x-2 cursor-pointer">
              <%= radio_button_tag "merge[field_choices][#{field}]", 'source', false %>
              <span class="text-sm text-gray-700">
                <%= merge_field_display_value(@project, field) %>
                <span class="text-gray-400">(<%= @project.title %>)</span>
              </span>
            </label>
            <label class="flex items-center space-x-2 cursor-pointer">
              <%= radio_button_tag "merge[field_choices][#{field}]", 'target', true %>
              <span class="text-sm text-gray-700">
                <%= merge_field_display_value(@target, field) %>
                <span class="text-gray-400">(<%= @target.title %>)</span>
              </span>
            </label>
          </div>
        </fieldset>
      <% end %>

      <div class="flex justify-end space-x-3">
        <%= link_to t('views.projects.form.cancel'), edit_project_path(@project),
              class: "px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" %>
        <%= f.submit t('views.projects.merge.confirm_button'),
              class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700",
              data: { confirm: t('views.projects.merge.confirm_dialog', source_title: @project.title, target_title: @target.title) } %>
      </div>
    <% end %>
  <% end %>
</div>
