<% role_options = ProjectMembership::ROLES.map { |role| [t("views.projects.edit.members.roles.#{role}"), role] } %>
<% addable_members = project.addable_members %>

<div class="mt-10 max-w-2xl">
  <h2 class="text-xl font-bold text-gray-900 mb-2"><%= t('views.projects.edit.members.title') %></h2>
  <p class="text-sm text-gray-500 mb-3"><%= t('views.projects.edit.members.help') %></p>

  <div class="surface shadow rounded-lg divide-y divide-gray-200">
    <div class="px-4 py-3 flex items-center justify-between gap-3">
      <div class="min-w-0">
        <span class="text-sm text-gray-900"><%= project.user.name %></span>
        <span class="block text-xs text-gray-500 truncate"><%= project.user.email %></span>
      </div>
      <span class="px-1.5 py-0.5 text-xs rounded-full bg-gray-100 text-gray-600 whitespace-nowrap">
        <%= t('views.projects.edit.members.owner_badge') %>
      </span>
    </div>

    <% memberships.each do |membership| %>
      <div class="px-4 py-3 flex flex-wrap items-center justify-between gap-3">
        <div class="min-w-0">
          <span class="text-sm text-gray-900"><%= membership.user.name %></span>
          <span class="block text-xs text-gray-500 truncate"><%= membership.user.email %></span>
        </div>
        <div class="flex items-center gap-2">
          <%= form_with url: project_membership_path(membership), method: :patch, class: "flex items-center gap-2" do %>
            <%= select_tag "project_membership[role]",
                  options_for_select(role_options, membership.role),
                  class: "rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500" %>
            <%= submit_tag t('views.projects.edit.members.save_role'),
                  class: "px-3 py-2 border border-transparent text-sm leading-4 font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700" %>
          <% end %>
          <%= button_to project_membership_path(membership), method: :delete,
                class: "text-red-600 hover:text-red-800",
                data: { confirm: t('views.projects.edit.members.remove_confirm', name: membership.user.name) } do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if memberships.empty? %>
      <p class="px-4 py-3 text-sm text-gray-500"><%= t('views.projects.edit.members.none_yet') %></p>
    <% end %>
  </div>

  <% if addable_members.any? %>
    <%= form_with url: project_project_memberships_path(project), method: :post, class: "mt-4 flex flex-wrap items-end gap-2" do %>
      <div>
        <%= label_tag "project_membership[user_id]", t('views.projects.edit.members.add_label'), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= select_tag "project_membership[user_id]",
              options_from_collection_for_select(addable_members, :id, ->(user) { "#{user.name} (#{user.email})" }),
              class: "rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>
      <div>
        <%= label_tag "project_membership[role]", t('views.projects.edit.members.role_label'), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= select_tag "project_membership[role]",
              options_for_select(role_options, "member"),
              class: "rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>
      <%= submit_tag t('views.projects.edit.members.add_button'),
            class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700" %>
    <% end %>
  <% else %>
    <p class="mt-4 text-sm text-gray-500"><%= t('views.projects.edit.members.nobody_to_add') %></p>
  <% end %>
</div>
