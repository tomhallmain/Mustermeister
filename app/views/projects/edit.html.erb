<div class="container mx-auto px-4 py-8 max-w-2xl">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900"><%= t('views.projects.form.edit_project') %></h1>
  </div>

  <%= render 'form', project: @project %>

  <%= render 'statuses', project: @project, statuses: @project.statuses.ordered %>

  <div class="mt-10 max-w-2xl">
    <h2 class="text-xl font-bold text-gray-900 mb-2"><%= t('views.projects.merge.section_title') %></h2>
    <p class="text-sm text-gray-500 mb-3"><%= t('views.projects.merge.section_help') %></p>
    <%= link_to t('views.projects.merge.menu_link'), merge_project_path(@project),
          class: 'bg-gray-700 hover:bg-gray-900 text-white font-bold py-2 px-4 rounded' %>
  </div>
</div>