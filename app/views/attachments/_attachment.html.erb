<div class="flex items-center justify-between p-4 surface rounded-lg" style="background-color: var(--color-surface-elevated);">
  <div class="flex-1 min-w-0">
    <div class="flex items-center justify-between">
      <%= link_to attachment.file.original_filename, download_attachment_path(attachment), class: "text-sm font-medium text-blue-600 hover:text-blue-800 truncate" %>
      <p class="text-sm text-gray-500 whitespace-nowrap ml-3"><%= number_to_human_size(attachment.file.size) %></p>
    </div>
    <p class="text-sm text-gray-500 mt-1">
      <%= t('views.attachments.uploaded_by', user: attachment.user.name, time: time_ago_in_words(attachment.created_at)) %>
    </p>
  </div>

  <%= button_to attachment_path(attachment),
      method: :delete,
      class: "text-gray-400 hover:text-red-500 ml-4",
      form: { data: { turbo: false } },
      data: { confirm: t('views.tasks.show.delete_confirm') } do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
    </svg>
  <% end %>
</div>
